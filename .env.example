# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local al repositorio.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: la usan src/servidor/admin.ts y los scripts. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (B5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Meta: WhatsApp Cloud API (B4) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Plantillas aprobadas por Meta para avisos fuera de la ventana de 24 h (fase plataforma; vacías en el MVP).
WHATSAPP_PLANTILLA_LISTO=
WHATSAPP_PLANTILLA_PENDIENTE_DOC=

# --- Resend: correos a la notaría (B6) ---
RESEND_API_KEY=
# Remitente verificado en Resend, por ejemplo: NotariApp <avisos@tu-dominio.com>
CORREO_REMITENTE=
# A dónde llegan las alertas. Para la demo, tu propio correo.
CORREO_NOTARIA=

# --- Tareas programadas (B6) ---
CRON_SECRET=

# --- Notaría y fase ---
# Código de la notaría que atiende el número de WhatsApp (ver supabase/seed.sql).
NOTARIA_CODIGO=SQ001
# Funciones de la plataforma de gestión (mis_tramites, avisos de estado). Apagadas en el bot MVP.
PLATAFORMA_ACTIVA=false
